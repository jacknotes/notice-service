# 生产部署前必须修改以下密码与密钥（docker compose 未设置会直接报错）
DB_PASSWORD=your_password
MYSQL_ROOT_PASSWORD=root_password
JWT_SECRET=change_me
ENCRYPT_KEY=0123456789abcdef0123456789abcdef
ADMIN_USER=admin
ADMIN_PASS=admin123

# 反向代理可信 CIDR（逗号分隔）：Webhook IP 白名单依赖它。
# 默认信任 127.0.0.1,::1 —— 对应「宿主 Nginx → 本机端口」的典型部署；
# Nginx 在其它节点时改成反代所在网段，如 10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1

# 是否暴露 /swagger API 文档（生产可选关闭）
SWAGGER_ENABLED=true

# 发送队列（可选，全部有默认值）
QUEUE_WORKERS=4
QUEUE_POLL_MS=1000
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BACKOFF=5s,30s,60s
QUEUE_CLAIM_TTL=120
LOG_RETENTION_DAYS=90
QUEUE_JOB_RETENTION_DAYS=30

# 审计日志保留天数（超出自动清理，默认 180）
AUDIT_RETENTION_DAYS=180
