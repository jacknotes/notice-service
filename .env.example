# 生产部署前必须修改以下密码与密钥（docker compose 未设置会直接报错）。
# 注意：这些占位值只是让 compose 的 :? 守卫通过，直接 cp 后不改 = 弱密钥裸跑；
# 建议同时设置 STRICT_SECRETS=1（见文件底部），密钥未改时服务拒绝启动。
DB_PASSWORD=please_change_me
MYSQL_ROOT_PASSWORD=please_change_me
# 生成强随机密钥：openssl rand -hex 32（两实例部署时 JWT_SECRET/ENCRYPT_KEY 必须一致）
JWT_SECRET=please_change_me_to_32_bytes_random_hex
ENCRYPT_KEY=please_change_me_to_32_bytes_random_hex
ADMIN_USER=admin
ADMIN_PASS=please_change_me_to_a_strong_password

# 反向代理可信 CIDR（逗号分隔）：Webhook IP 白名单依赖它。
# 默认信任 127.0.0.1,::1（环回）+ 172.16.0.0/12（Docker 默认网桥网段）。
# 本部署为「宿主机 Nginx → docker-compose 容器」形态：应用看到的连接源是网桥网关
# （如 172.18.0.1）而非 127.0.0.1，必须放行网桥网段才能取到真实客户端 IP；
# Nginx 在其它节点时改成反代所在网段，如 10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Docker 构建镜像源（国内网络访问不到 Docker Hub 时设置）：
# 基础镜像前缀，如 docker.m.daocloud.io/library/；MySQL 镜像同理
# IMAGE_PREFIX=docker.m.daocloud.io/library/
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:5.7

# 是否暴露 /swagger API 文档。默认关闭（应用内置默认值即 false）；
# 仅开发环境临时打开，生产保持关闭。
SWAGGER_ENABLED=false

# 弱密钥严格模式：检测到默认/弱 JWT_SECRET / ENCRYPT_KEY / ADMIN_PASS 时
# 拒绝启动（不设置或设为 0 时仅告警继续，便于开发环境）。
STRICT_SECRETS=1

# 发送队列（可选，全部有默认值）
QUEUE_WORKERS=4
QUEUE_POLL_MS=1000
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BACKOFF=5s,30s,60s
QUEUE_CLAIM_TTL=120
LOG_RETENTION_DAYS=90
QUEUE_JOB_RETENTION_DAYS=30

# 审计日志保留天数（超出自动清理，默认 180）
AUDIT_RETENTION_DAYS=180

# 监控（可选）
# METRICS_ENABLED=true
# METRICS_USER=
# METRICS_PASSWORD=
