# 统一换行符处理，避免跨平台协作时的 CRLF/LF 噪音
* text=auto

# 源码与配置统一为 LF 入库
*.go text
*.json text
*.yaml text
*.yml text
*.vue text
*.js text
*.ts text
*.css text
*.html text
*.md text
*.sql text
*.sh text eol=lf
Dockerfile text
Makefile text

# Windows 批处理必须为 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.gz binary
*.zip binary
